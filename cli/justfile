# abx — the operator CLI (pm/cli.mdx). Run `just` to list.
#
# This exists so the CLI can be worked on alone. The ROOT justfile also builds
# it, because the CLI must never be stale relative to the app (§2.3).

set shell := ["bash", "-uc"]

root := justfile_directory()
repo := parent_directory(justfile_directory())

default:
    @just --list

# Compile code/src -> code/dist.
build:
    cd "{{root}}" && node "{{repo}}/node_modules/typescript/bin/tsc" -p code/tsconfig.json

# Typecheck without emitting.
typecheck:
    cd "{{root}}" && node "{{repo}}/node_modules/typescript/bin/tsc" -p code/tsconfig.json --noEmit

# Unit tests and canaries (builds first: the canary greps the BUILT output).
test: build
    cd "{{root}}" && npx vitest --run --root code

# Run the CLI from source: `just run -- accounts list`.
run *ARGS:
    cd "{{root}}" && ./abx {{ARGS}}

# Print the PATH line to add to ~/.zshrc (never edits the profile itself).
install-cli:
    @echo 'export PATH="{{root}}:$PATH"   # add to ~/.zshrc'

clean:
    rm -rf "{{root}}/code/dist"
